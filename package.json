{
  "name": "petromac-kiosk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "data": "tsx scripts/node/data-pipeline.ts",
    "data:operations": "tsx scripts/node/data-pipeline.ts --operations-only",
    "data:flipbooks": "tsx scripts/node/data-pipeline.ts --flipbooks-only",
    "data:check": "pnpm run validate:flipbooks && pnpm run validate:successstories",
    "validate:successstories": "tsx scripts/node/validate-successstories.ts",
    "validate:flipbooks": "tsx scripts/node/validate-flipbooks.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{md,json,css,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "d3-array": "^3.2.4",
    "d3-fetch": "^3.0.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "framer-motion": "^12.7.3",
    "next": "16.2.4",
    "page-flip": "^2.0.7",
    "papaparse": "^5.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.175.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-fetch": "^3.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
