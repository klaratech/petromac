# App Configuration
# Public site URL (used for canonical links, OG image absolute paths, sitemap, etc.).
# Standard name across our projects: NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy alias kept for compatibility — prefer NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Microsoft staff identity for intranet + kiosk
# Register an Entra app and add:
#   http://localhost:3000/auth/microsoft/callback
#   https://petromac.klaratech.it/auth/microsoft/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
STAFF_SESSION_SECRET=
# Optional: lock Microsoft sign-in to company mail domains
# STAFF_ALLOWED_EMAIL_DOMAINS=petromac.co.nz,petromac.com
# Optional: override scopes if needed
# ENTRA_SCOPES=openid profile email offline_access User.Read Mail.Send

# Athena links shown on the intranet page (optional, has defaults)
# NEXT_PUBLIC_ATHENA_PROD_URL=https://athena.petromac.co.nz/
# NEXT_PUBLIC_ATHENA_TEST_URL=https://test.athena.digitaltwins.com.bo/#/login

# Content pipeline: no env vars needed. Drop source files into the
# sources/ folders and run `pnpm run data` — see sources/README.md.

# Backend + CORS
# API_BASE_URL is used by server-side frontend code (e.g. http://petromac-backend:8000 over the docker network in prod).
# NEXT_PUBLIC_API_BASE_URL is used by the browser.
# In production both can use relative /api calls — Cloudflare Tunnel routes
# petromac.klaratech.it/api/* to localhost:8012 (the backend container).
#
# Backend CORS / origin validation
# ALLOWED_ORIGINS=http://localhost:3000,https://petromac.klaratech.it

# SMTP Configuration — used by the backend for ALL outbound email (contact form + PDF sends)
#
# Office 365 (recommended):
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_PASS=<app password if MFA is on, otherwise regular password>
#   Admin prerequisite: Microsoft 365 Admin Center > Users > Active Users >
#     select the sending account > Mail > Manage email apps > enable "Authenticated SMTP"
#   If MFA is enabled on the account, generate an App Password:
#     https://support.microsoft.com/en-us/account-billing/manage-app-passwords-for-two-step-verification-d6dc8c6d-4bf7-4851-ad95-6d07799387e9
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_PASS=<app password — regular password won't work>
#   https://support.google.com/accounts/answer/185833
#
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sender@yourcompany.com
SMTP_PASS=your-app-password-here

# Unified "from" address for all outbound email (falls back to SMTP_USER)
CONTACT_FROM_EMAIL=sender@yourcompany.com
# Contact form submissions are delivered to this address
CONTACT_TO_EMAIL=recipient@example.com

# Email Security (optional - restricts who can receive emails via API)
# Comma-separated lists. If unset, only CONTACT_TO_EMAIL is allowed.
# ALLOWED_EMAIL_DOMAINS=petromac.co.nz,example.com
# ALLOWED_EMAIL_RECIPIENTS=user@example.com
# ALLOWED_ORIGINS=https://petromac.klaratech.it
