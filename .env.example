# App Configuration
# Public site URL (used for canonical links, OG image absolute paths, sitemap, etc.).
# Standard name across our projects: NEXT_PUBLIC_SITE_URL.
# INDEXABILITY: any URL other than https://www.petromac.co.nz (or the apex)
# ships noindex on every page + a Disallow-all robots.txt. The production
# deploy must set NEXT_PUBLIC_SITE_URL=https://www.petromac.co.nz AND
# NEXT_PUBLIC_ENV=production — next.config.ts fails the build if the pair
# is inconsistent (see src/lib/siteUrl.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ENV=production
# Legacy alias kept for compatibility — prefer NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Microsoft staff identity for intranet + kiosk
# Register an Entra app and add:
#   http://localhost:3000/auth/microsoft/callback
#   https://www.petromac.co.nz/auth/microsoft/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
STAFF_SESSION_SECRET=
# Optional: lock Microsoft sign-in to company mail domains
# STAFF_ALLOWED_EMAIL_DOMAINS=petromac.co.nz,petromac.com
# Optional: override scopes if needed
# ENTRA_SCOPES=openid profile email offline_access User.Read Mail.Send

# Athena links shown on the intranet page (optional, has defaults)
# NEXT_PUBLIC_ATHENA_PROD_URL=https://athena.petromac.co.nz/
# NEXT_PUBLIC_ATHENA_TEST_URL=https://test.athena.digitaltwins.com.bo/#/login

# Content pipeline: no env vars needed. Drop source files into the
# sources/ folders and run `pnpm run data` — see sources/README.md.

# Backend + CORS
# API_BASE_URL is used by server-side frontend code (e.g. http://petromac-backend:8000 over the docker network in prod).
# NEXT_PUBLIC_API_BASE_URL is used by the browser.
# In production both can use relative /api calls — Cloudflare Tunnel routes
# www.petromac.co.nz/api/* to localhost:8012 (the backend container).
#
# Backend CORS / origin validation
# ALLOWED_ORIGINS=http://localhost:3000,https://www.petromac.co.nz

# Email — all outbound mail (contact form + PDF sends) goes through Microsoft
# Graph using the Entra app's *application* Mail.Send permission. No SMTP, no
# mailbox password, no license needed — it sends AS the shared mailbox below.
# The backend reuses ENTRA_TENANT_ID / ENTRA_CLIENT_ID / ENTRA_CLIENT_SECRET
# (same app as staff sign-in) — put those in the backend env too.
#
# Admin prerequisite (one time): in the Entra app, add Microsoft Graph
# APPLICATION permission "Mail.Send" and Grant admin consent.
#
# The mailbox mail is sent as (and saved to its Sent Items):
MAIL_SENDER=info@petromac.co.nz
# Contact form submissions are delivered here:
CONTACT_TO_EMAIL=info@petromac.co.nz

# Cloudflare Turnstile on the contact form (anti-spam).
# Create the widget: Cloudflare dashboard -> Turnstile -> Add site
# (domains: petromac.co.nz; mode: Managed — dev uses the test keys below).
# Set BOTH keys or NEITHER: the widget renders only when the site key is
# baked into the frontend build (repo variable NEXT_PUBLIC_TURNSTILE_SITE_KEY
# -> Docker build-arg), and the backend enforces only when the secret is set
# in .env-backend. Cloudflare's test pair for local dev:
# sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Email Security (optional - restricts who can receive emails via API)
# Comma-separated lists. If unset, only CONTACT_TO_EMAIL is allowed.
# ALLOWED_EMAIL_DOMAINS=petromac.co.nz,example.com
# ALLOWED_EMAIL_RECIPIENTS=user@example.com
# ALLOWED_ORIGINS=https://www.petromac.co.nz,https://petromac.co.nz
